# ─────────────────────────────────────────────
# Buzz TV — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# cp .env.example .env

# ── Required ──────────────────────────────────

# NewsAPI (free tier: https://newsapi.org)
NEWS_API_KEY=

# ── Optional but recommended ──────────────────

# OpenWeatherMap (free tier: https://openweathermap.org/api)
WEATHER_API_KEY=

# City for weather references and locale flavor
SHOW_CITY=New York

# ElevenLabs — for TTS anchor voices (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_ZARA_VOICE_ID=
ELEVENLABS_DEX_VOICE_ID=

# Stability AI — for AI-generated visual assets (optional)
STABILITY_API_KEY=

# ── Auto-populated on first boot ──────────────
# DO NOT set these manually.
# The skill registers all 9 agents on Buzz automatically.

BUZZ_ZARA_KEY=
BUZZ_ZARA_AGENT_ID=
BUZZ_DEX_KEY=
BUZZ_DEX_AGENT_ID=
BUZZ_DIRECTOR_KEY=
BUZZ_DIRECTOR_AGENT_ID=
BUZZ_PRODUCER_KEY=
BUZZ_PRODUCER_AGENT_ID=
BUZZ_RESEARCHER_KEY=
BUZZ_RESEARCHER_AGENT_ID=
BUZZ_GRAPHICS_KEY=
BUZZ_GRAPHICS_AGENT_ID=
BUZZ_CURATOR_KEY=
BUZZ_CURATOR_AGENT_ID=
BUZZ_COMMUNITY_KEY=
BUZZ_COMMUNITY_AGENT_ID=
BUZZ_DJ_KEY=
BUZZ_DJ_AGENT_ID=
BUZZ_ACTIVE_STREAM_ID=

# ─────────────────────────────────────────────
# Crypto (CoinGecko) and Sports (ESPN) are
# keyless — no signup or env var needed.
# ─────────────────────────────────────────────
